NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CSP(img-src·connect-src)와 next/image 허용 호스트에 사용.
# 비워두면 NEXT_PUBLIC_SUPABASE_URL의 hostname을 그대로 쓴다.
NEXT_PUBLIC_SUPABASE_HOSTNAME=your-project.supabase.co

# Supabase 로컬 개발용 Google OAuth provider (supabase/config.toml에서 참조)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

NEXT_PUBLIC_APP_URL=http://localhost:3000

APP_URL=http://localhost:3000

# sitemap·robots·메타데이터의 canonical URL. 비워두면 운영 URL로 폴백하므로
# Vercel preview 배포에서는 해당 배포 URL을 넣는다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# web-push 스펙상 subject는 https: 또는 mailto:만 허용한다.
# http://localhost는 거부되므로 로컬에서 푸시를 검증할 때 mailto: 값이 필요하다.
VAPID_SUBJECT=mailto:your-email@example.com

# Vercel Cron
CRON_SECRET=your-cron-secret

# AEAD 기반 이메일 인증 ticket 암호화/복호화에 사용하는 서버 전용 비밀 키
EMAIL_TICKET_SECRET=email-ticket-secret

# 현재 코드에서 참조하지 않음 (src/·.github/·scripts/ 참조 0건)
SUPABASE_HOOK_SECRET=supabase-hook-secret

# Gemini API 키 (AI 퀴즈 생성 · 백지 테스트 채점에 사용, src/lib/gemini/client.ts)
GEMINI_API_KEY=your-gemini-api-key

# AI Provider API 키 (공통 AI Provider 실행에 사용)
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key

# Resend 이메일 전송 API 키 (이메일 발송에 사용)
RESEND_API_KEY=your-resend-api-key
AUTH_EMAIL_FROM=noreply@your-domain.com

# 현재 무시됨 — resolveEmailProvider.ts가 Resend 도메인 검증 완료 전까지
# 모든 환경에서 nodemailer를 고정 반환한다.
AUTH_EMAIL_PROVIDER=nodemailer

# Nodemailer SMTP 설정 (개발 환경 기본)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password

# 로컬에서 supabase webhook 사용 
NGROK_AUTHTOKEN=ngrok-authtoken
